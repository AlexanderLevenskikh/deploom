{
  "name": "deploom",
  "private": true,
  "version": "0.2.186",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.electron.json && tsc -b && vite build",
    "check:updater-runtime": "node scripts/check-updater-runtime.mjs",
    "check:updater-schedule": "node scripts/check-updater-schedule.mjs",
    "check:updater-error": "node scripts/check-updater-error.mjs",
    "check:public-update-target": "node scripts/check-public-update-target.mjs",
    "check:repair-handoff": "node scripts/check-repair-handoff.mjs",
    "check:repair-dispatch": "node scripts/check-repair-dispatch.mjs",
    "check:agent-command": "node scripts/check-agent-command.mjs",
    "precheck:migration-progress": "tsc -p tsconfig.electron.json",
    "check:migration-progress": "node scripts/check-migration-progress.mjs",
    "check:flow-state": "node scripts/check-flow-state.mjs",
    "check:state-commit": "node scripts/check-state-commit.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:target-closure": "node scripts/check-target-closure.mjs",
    "check:h5-budget-priority": "node scripts/check-h5-budget-priority.mjs",
    "check:project-settings": "node scripts/check-project-settings.mjs",
    "check:workspace-bootstrap": "node scripts/check-workspace-bootstrap.mjs",
    "check:log-presentation": "node scripts/check-log-presentation.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "precheck:iterative-migration": "tsc -p tsconfig.electron.json",
    "check:iterative-migration": "node scripts/check-iterative-migration.mjs",
    "precheck:iterative-archive": "tsc -p tsconfig.electron.json",
    "check:iterative-archive": "node scripts/check-iterative-archive.mjs",
    "precheck:task-clipboard": "tsc -p tsconfig.electron.json",
    "check:task-clipboard": "node scripts/check-task-clipboard.mjs",
    "precheck:electron-clipboard": "tsc -p tsconfig.electron.json",
    "check:electron-clipboard": "node scripts/check-electron-clipboard.mjs",
    "check:run-monitor": "node scripts/check-run-monitor.mjs",
    "check:app-icon": "node scripts/check-app-icon.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "package": "npm run build && npm run prepare:tool && electron-builder",
    "package:win": "npm run build && npm run prepare:tool && electron-builder --win nsis --x64 --publish never",
    "package:win:ci": "npm run build && cross-env TOOL_VENDOR_PLATFORM=win_amd64 node scripts/prepare-tool.mjs && electron-builder --config electron-builder.ci.yml --win nsis --x64 --publish never",
    "package:dir": "npm run build && npm run prepare:tool && electron-builder --dir",
    "prepare:tool": "node scripts/prepare-tool.mjs",
    "check:release-policy": "node scripts/check-release-policy.mjs",
    "check:merge-recovery": "node scripts/check-merge-recovery.mjs",
    "check:dashboard-state": "node scripts/check-dashboard-state.mjs",
    "check:agent-efficiency": "node scripts/check-agent-efficiency.mjs",
    "check:executor-context": "node scripts/check-executor-context.mjs",
    "check:materialization-proof": "node scripts/check-materialization-proof.mjs",
    "check:resolved-state-proof": "node scripts/check-resolved-state-proof.mjs",
    "check:flow-recovery": "node scripts/check-flow-recovery.mjs",
    "check:migration-verification": "node scripts/check-migration-verification.mjs",
    "check:planner-session": "node scripts/check-planner-session.mjs",
    "check:deterministic-planner": "node scripts/check-deterministic-planner.mjs",
    "check:autonomy-policy": "node scripts/check-autonomy-policy.mjs",
    "check:autopilot": "node scripts/check-autopilot.mjs",
    "check:autopilot-scenarios": "node scripts/check-autopilot-scenarios.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "check:parallel-groups": "node scripts/check-parallel-groups.mjs",
    "check:process-launcher": "node scripts/check-process-launcher.mjs",
    "package:linux": "npm run build && cross-env TOOL_VENDOR_PLATFORM=manylinux2014_x86_64 node scripts/prepare-tool.mjs && electron-builder --linux --x64 --publish never",
    "package:mac:x64": "npm run build && cross-env TOOL_VENDOR_PLATFORM=macosx_11_0_x86_64 node scripts/prepare-tool.mjs && electron-builder --mac --x64 --publish never",
    "package:mac:arm64": "npm run build && cross-env TOOL_VENDOR_PLATFORM=macosx_11_0_arm64 node scripts/prepare-tool.mjs && electron-builder --mac --arm64 --publish never",
    "check:cross-platform": "node scripts/check-cross-platform.mjs",
    "check:ui-shell": "node scripts/check-ui-shell.mjs",
    "check:baseline-failure-message": "node scripts/check-baseline-failure-message.mjs",
    "check:baseline-intent": "node scripts/check-baseline-intent.mjs",
    "check:baseline-intent-migration": "node scripts/check-baseline-intent-migration.mjs",
    "check:baseline-worker-hardening": "node scripts/check-baseline-worker-hardening.mjs",
    "check:baseline-retry": "node scripts/check-baseline-retry.mjs",
    "check:interaction-contracts": "node scripts/check-interaction-contracts.mjs",
    "check:dependency-graph": "node scripts/check-dependency-graph.mjs",
    "check:ui-lifecycle": "node scripts/check-ui-lifecycle.mjs",
    "check:acceptance-policy": "node scripts/check-acceptance-policy.mjs",
    "check:progressive-contract": "node scripts/check-progressive-contract.mjs",
    "check:human-flow": "node scripts/check-human-flow.mjs",
    "check:target-precedence": "node scripts/check-target-precedence.mjs",
    "check:baseline-worker-retire": "node scripts/check-baseline-worker-retire.mjs",
    "check:baseline-worker-cancel": "node scripts/check-baseline-worker-cancel.mjs",
    "check:run-slot-isolation": "node scripts/check-run-slot-isolation.mjs",
    "check:artifact-token": "node scripts/check-artifact-token.mjs",
    "precheck:iterative-runner": "tsc -p tsconfig.electron.json",
    "check:iterative-runner": "node scripts/check-iterative-runner.mjs",
    "precheck:iterative-begin": "tsc -p tsconfig.electron.json",
    "check:iterative-begin": "node scripts/check-iterative-begin.mjs",
    "precheck:iterative-attempt": "tsc -p tsconfig.electron.json",
    "check:iterative-attempt": "node scripts/check-iterative-attempt.mjs",
    "precheck:iterative-stream": "tsc -p tsconfig.electron.json",
    "check:iterative-stream": "node scripts/check-iterative-stream.mjs",
    "precheck:iterative-scenario": "tsc -p tsconfig.electron.json",
    "check:iterative-scenario": "node scripts/check-iterative-scenario.mjs",
    "precheck:iterative-agent": "tsc -p tsconfig.electron.json",
    "check:iterative-agent": "node scripts/check-iterative-agent.mjs",
    "precheck:agent-launch-errors": "tsc -p tsconfig.electron.json",
    "check:agent-launch-errors": "node scripts/check-agent-launch-errors.mjs",
    "check:storage-maintenance": "node scripts/check-storage-maintenance.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  },
  "description": "Cross-platform dependency upgrade orchestrator",
  "main": "dist-electron/main.js",
  "allowScripts": {
    "electron@43.2.0": true
  },
  "author": "DepLoom contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "io.github.alexanderlevenskikh.deploom.desktop"
}
