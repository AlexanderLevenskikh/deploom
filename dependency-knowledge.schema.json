{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dependency-roadmap.local/dependency-knowledge.schema.json",
  "title": "Dependency Roadmap Migration Knowledge Log",
  "type": "object",
  "required": ["schemaVersion", "type", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "type": { "const": "dependency-roadmap-knowledge-log" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "recordedAt", "packages", "title", "symptom", "cause", "guidance", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "recordedAt": { "type": "string", "format": "date" },
        "packages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "title": { "type": "string", "minLength": 1 },
        "symptom": { "type": "string", "minLength": 1 },
        "cause": { "type": "string", "minLength": 1 },
        "guidance": { "type": "string", "minLength": 1 },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "string", "enum": ["verified", "hypothesis"], "default": "hypothesis" },
        "status": { "type": "string", "enum": ["active", "retracted"], "default": "active" },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "applicability": {
          "type": "object",
          "properties": {
            "currentVersionRange": { "type": "string" },
            "targetVersionRange": { "type": "string" },
            "packageManagers": { "type": "array", "items": { "enum": ["npm", "yarn", "pnpm"] } },
            "configurationModes": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "reference"],
            "properties": {
              "kind": { "type": "string" },
              "reference": { "type": "string" },
              "result": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
